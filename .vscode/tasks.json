{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "comprobar (el objetivo unico: formato, vet, build y las puertas)",
      "type": "shell",
      "command": "bash ./comprobar.sh",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$go"
    },
    {
      "label": "DEPURAR: puertas de raiz (AST, extensibilidad, linter, dorados, ciclo e2e)",
      "type": "shell",
      "command": "go test . -count=1 -v",
      "problemMatcher": "$go"
    },
    {
      "label": "cobertura del corpus",
      "type": "shell",
      "command": "go run ./cmd/plazum cobertura paquetes",
      "problemMatcher": []
    }
  ]
}
